# Runtime data. METRIX_HOME defaults to ~/.metrix, outside the repo -- but a
# .metrix/ here opts this checkout into keeping its own recordings, and those
# are local facts, not repo facts.
/.metrix/
/metrix-data/
*.db
*.ndjson
